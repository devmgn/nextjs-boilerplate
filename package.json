{
  "name": "nextjs-boilerplate",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || true",
    "postinstall": "msw init",
    "apm": "apm install -t claude",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "ultracite check && pnpm lint:dead-code",
    "fix": "ultracite fix",
    "lint:workflows": "actionlint -color && zizmor .github/",
    "lint:dead-code": "fallow dead-code && fallow dead-code --production",
    "lint:fallow": "fallow dead-code && fallow dupes && fallow health --report-only && fallow security",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:oxlint-rules": "vitest run --project=oxlint-rules",
    "test:update": "vitest run --update",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "analyze": "next experimental-analyze",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-api": "pnpm dlx @openapitools/openapi-generator-cli generate -i openapi.yml -g typescript-fetch -o ./src/api/openapi -c openapiconfig.json --openapi-normalizer SET_TAGS_FOR_ALL_OPERATIONS=default",
    "generate-api:clean": "rm -rf src/api/openapi && pnpm generate-api",
    "generate-mock": "d=$(mktemp -d) && msw-auto-mock openapi.yml -o \"$d\" --typescript --base-url https://jsonplaceholder.typicode.com && mv \"$d/handlers.ts\" ./src/mocks/handlers.ts && rm -rf \"$d\" && sed -i '' 's|from \"@faker-js/faker\"|from \"@faker-js/faker/locale/ja\"|' ./src/mocks/handlers.ts",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "next": "16.3.8",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "8.0.0-beta.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@next/env": "16.3.8",
    "@oxlint/plugins": "1.86.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/nextjs-vite": "10.6.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.13.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.1",
    "fallow": "3.31.0",
    "happy-dom": "20.14.5",
    "lefthook": "2.1.16",
    "msw": "3.0.2",
    "msw-auto-mock": "0.32.1",
    "msw-storybook-addon": "3.0.3",
    "oxc-transform-react": "0.152.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-plugin-react-doctor": "0.9.14",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "msw": {
    "workerDirectory": "public"
  }
}
