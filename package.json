{
  "name": "nextjs-boilerplate",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || true",
    "postinstall": "msw init && orval",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "ultracite check && pnpm lint:dead-code",
    "fix": "ultracite fix",
    "lint:dead-code": "fallow dead-code && fallow dead-code --production",
    "lint:fallow": "fallow dead-code && fallow dupes && fallow health --report-only && fallow security",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:oxlint-rules": "vitest run --project=oxlint-rules",
    "test:update": "vitest run --update",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "analyze": "next experimental-analyze",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-api": "orval",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-query-devtools": "5.106.1",
    "next": "16.4.5",
    "nuqs": "2.10.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "8.0.0-beta.5",
    "sonner": "2.0.8",
    "tailwind-variants": "4.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@next/env": "16.4.5",
    "@oxlint/plugins": "1.91.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-mcp": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/turbopack": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.106.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.7",
    "eslint-plugin-tsdoc": "0.5.4",
    "fallow": "3.39.0",
    "happy-dom": "21.0.4",
    "lefthook": "2.2.1",
    "msw": "3.0.5",
    "msw-storybook-addon": "3.0.3",
    "orval": "8.46.0",
    "oxc-transform-react": "0.157.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.64.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "msw": {
    "workerDirectory": "public"
  }
}
