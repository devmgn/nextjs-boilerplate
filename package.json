{
  "name": "nextjs-boilerplate",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || true",
    "apm": "apm install -t claude",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "pnpm lint && pnpm fmt && pnpm knip",
    "fix": "pnpm lint:fix && pnpm fmt:fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:workflows": "actionlint -color && zizmor .github/",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "knip": "knip && knip --production",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:oxlint-rules": "vitest run --project=oxlint-rules",
    "test:update": "vitest run --update",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "analyze": "next experimental-analyze",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate-api": "pnpm dlx @openapitools/openapi-generator-cli generate -i openapi.yml -g typescript-fetch -o ./src/api/openapi -c openapiconfig.json --openapi-normalizer SET_TAGS_FOR_ALL_OPERATIONS=default",
    "generate-api:clean": "rm -rf src/api/openapi && pnpm generate-api",
    "generate-mock": "msw-auto-mock openapi.yml -o ./src/mocks --typescript --base-url https://jsonplaceholder.typicode.com && sed -i '' 's|from \"@faker-js/faker\"|from \"@faker-js/faker/locale/ja\"|' ./src/mocks/handlers.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.102.7",
    "@tanstack/react-query-devtools": "5.102.7",
    "next": "16.3.4",
    "nuqs": "2.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.3",
    "react-hook-form": "8.0.0-beta.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@next/env": "16.3.4",
    "@oxlint/plugins": "1.80.0",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.102.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint-plugin-storybook": "10.5.10",
    "happy-dom": "20.11.10",
    "knip": "6.32.3",
    "lefthook": "2.1.10",
    "msw": "2.15.0",
    "msw-auto-mock": "0.32.1",
    "msw-storybook-addon": "3.0.0",
    "oxc-transform-react": "0.147.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "msw": {
    "workerDirectory": "public"
  }
}
